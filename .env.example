DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
API_KEY=

/*
 * Configurações para o usuário root do MySQL, usado apenas para rodar o setup inicial.
 * NÃO use este usuário em produção. Ele é apenas para criar o banco de dados e o usuário do app.
 */
DB_SETUP_USER=root
DB_SETUP_PASS=root
JWT_SECRET="xxxxxxxx"//vai ser substituido depois para uma string mais encorpada e gerada aleatoriamente, assim como a chave da api.
/*
    * Configurações do usuário administrador do sistema(operador do RU). Ele é criado na primeira vez que o sistema é iniciado, usando as credenciais abaixo.
    * NÃO use este usuário em produção. Ele é apenas para criar o usuário administrador inicial.
    * A senha do administrador será alterada na primeira vez que ele logar no sistema.
*/
ADMIN_USUARIO=
ADMIN_NOME=
ADMIN_SENHA=
